# Everything is text with LF in the repo and on checkout; shell scripts run
# inside Linux containers and CRLF breaks them.
* text=auto eol=lf
*.sh text eol=lf

# Binary task assets
*.png binary
*.jpg binary
*.gz binary
*.zip binary
*.tar binary
