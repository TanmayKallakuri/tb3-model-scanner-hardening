{
  "n_attempts": 3,
  "jobs_dir": "jobs",
  "n_concurrent_trials": 2,
  "environment": {
    "type": "docker"
  },
  "tasks": [
    {
      "path": "tasks/model-scanner-hardening"
    }
  ],
  "agents": [
    {
      "name": "claude-code",
      "model_name": "anthropic/claude-fable-5-1",
      "kwargs": {
        "reasoning_effort": "max"
      },
      "env": {
        "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "128000"
      }
    }
  ]
}
